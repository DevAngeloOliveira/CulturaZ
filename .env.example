# ============================================================
# CulturaZ — exemplo de variáveis de ambiente
# Copie este arquivo para .env (raiz), apps/api/.env e
# apps/mobile/.env conforme necessário.
# Nunca comite arquivos .env reais.
# ============================================================

# ---------- Banco de dados (PostgreSQL local via Docker Compose) ----------
DATABASE_URL=jdbc:postgresql://localhost:5432/culturaz
DATABASE_USERNAME=culturaz
DATABASE_PASSWORD=culturaz

# ---------- API ----------
API_PORT=8080
SPRING_PROFILES_ACTIVE=local

# ---------- Autenticação (futuro) ----------
# Gerar um segredo forte em produção (>= 256 bits).
JWT_SECRET=change-me-in-production-please-use-a-real-random-secret
JWT_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=30

# ---------- Mobile (Expo) ----------
# Variáveis prefixadas com EXPO_PUBLIC_ são embutidas no bundle do app.
EXPO_PUBLIC_API_URL=http://localhost:8080
EXPO_PUBLIC_ENV=local
