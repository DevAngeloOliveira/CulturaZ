{
  "expo": {
    "name": "CulturaZ",
    "slug": "culturaz",
    "version": "0.1.0",
    "scheme": "culturaz",
    "orientation": "portrait",
    "icon": "./assets/culturaz-app-icon-1024.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#173F35"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.culturaz.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/culturaz-app-icon-1024.png",
        "backgroundColor": "#173F35"
      },
      "package": "com.culturaz.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "40734117-6914-4464-a5d5-79fbfb878832"
      }
    },
    "owner": "devangelooliveira"
  }
}
